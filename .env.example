# Public URL of the site (used for share links, Stripe redirects, magic-link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on Terms, Privacy and Rules as the contact address (hidden when empty)
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API: console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe: dashboard.stripe.com (use test keys while developing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
# Optional: the $39.99/year Plus price. The yearly button shows only when this is set.
STRIPE_PRICE_PLUS_YEARLY=

# Cost controls
# Max photo scans across the whole site per UTC day. Protects you from a surprise bill if a video goes viral.
DAILY_SCAN_CAP=2000
# Photo scans: per guest (ever), per network per day for guests, per free account per week, per Plus account per day
GUEST_SCANS=1
GUEST_IP_SCANS_PER_DAY=5
FREE_SCANS_PER_WEEK=3
PLUS_SCANS_PER_DAY=40
# Random string used to hash visitor IPs for rate limiting (never store raw IPs)
IP_HASH_SALT=change-me
